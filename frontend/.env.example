# TraceIt Frontend Environment Variables
# Copy this file to .env and fill in the values

# API Configuration
VITE_API_URL="http://localhost:3001/api"
VITE_SOLANA_NETWORK="devnet" # Options: devnet, testnet, mainnet-beta

# Feature Flags (optional)
VITE_FEATURE_BLOCKCHAIN_ENABLED="false"
VITE_FEATURE_ANALYTICS_ENABLED="true"
VITE_FEATURE_NOTIFICATIONS_ENABLED="true"

# Build Configuration
VITE_APP_NAME="TraceIt"
VITE_APP_VERSION="1.0.0"