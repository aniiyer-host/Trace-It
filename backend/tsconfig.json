{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "ESnext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "types": ["node", "express", "jest", "supertest"]
  },
  // "include": ["src/**/*", "generated/prisma/**/*"]
  "include": ["src/**/*", "generated/prisma/**/*", "tests/**/*"],
  "exclude": []
}
