// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS from SQL

enum UserRole {
  DONOR
  CHARITY
  ADMIN
  AUDITOR
}

enum NgoStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum KycStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum DonationStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  ALLOCATED
  DISBURSED
  DELIVERED
}

enum DocumentType {
  NGO_CERT
  PAN_CARD
  AADHAR
  FIELD_REPORT
  BANK_TRANSFER_EVIDENCE
  COHORT_PROOF
  TAX_RECEIPT
  GOV_EXPORT
  CAMPAIGN_MEDIA
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
  LEGAL_HOLD
}

enum DisbursementType {
  PROOF_OF_NEED
  PROOF_OF_WORK
}

enum DisbursementStatus {
  PENDING
  APPROVED
  SENT
  SETTLED
  FAILED
  REJECTED
}

enum GovernmentRequestStatus {
  OPEN
  PROCESSING
  COMPLETED
  EXPIRED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  SOLANA_STUB
}

enum AuditActorType {
  USER
  SYSTEM
  WEBHOOK
  ADMIN
}

enum AttestationType {
  RECEIPT
  DELIVERY
}

enum AttestationStatus {
  PENDING
  NGO_SIGNED
  APPROVED
  REJECTED
}

enum ProvenanceEventType {
  DONATION_SUCCESS
  DONATION_FAILED
  DONATION_ALLOCATED
  DONATION_DISBURSED
  DONATION_DELIVERED
  DONATION_REFUNDED
  DISBURSEMENT_APPROVED
  NGO_APPROVED
  COHORT_REGISTERED
  BANK_TRANSFER_REPORTED
  BANK_TRANSFER_EVIDENCE_APPROVED
  BANK_TRANSFER_EVIDENCE_REJECTED
}

enum AnchorStatus {
  PENDING
  BATCHED
  ANCHORED
  FAILED
}

enum EmailMilestone {
  DONATION_SUCCESS
  FUNDS_ALLOCATED
  BENEFICIARY_TRANSFER_REVIEWED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
// MODELS

// Profiles table -> model Profile
model Profile {
  id            String   @id @default(uuid())
  authUserId    String?   @unique
  email         String   @unique
  fullName      String?
  phone         String?
  role          UserRole @default(DONOR)
  isVerified    Boolean  @default(false)
  ngoStatus     NgoStatus @default(PENDING)
  kycStatus     KycStatus @default(NOT_REQUIRED)
  registrationNo String?
  organisationName String?
  panHash       String?
  solWalletAddress String?
  refreshTokenHash String?
  passwordHash  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  emailVerifications EmailVerification[] @relation("emailVerifications")
  donationsMade        Donation[]          @relation("DonorDonations")
  donationsReceived    Donation[]          @relation("NgoDonations")
  campaigns            Campaign[]
  cohorts              BeneficiaryCohort[]
  documents            Document[]
  disbursementsAsNgo   Disbursement[]    @relation("disbursementsAsNgo")
  bankTransfersAsNgo   BankTransfer[]    @relation("bankTransfersAsNgo")
  bankTransfersReviewed BankTransfer[]   @relation("bankTransfersReviewed")
  impactTokensAsDonor  ImpactToken[]     @relation("impactTokensAsDonor")
  auditLogsAsActor     AuditLog[]        @relation("auditLogsAsActor")
  govRequestsAsCreatedBy GovernmentRequest[] @relation("govRequestsAsCreatedBy")
  govRequestsAsTarget  GovernmentRequest[] @relation("govRequestsAsTarget")
  govRequestsProcessed GovernmentRequest[] @relation("govRequestsProcessed")

  @@index([email])
  @@index([role])
  @@index([ngoStatus])
  @@index([kycStatus])
  @@map("profiles")
}

// Email OTP Verifications
model EmailVerification {
  id        String   @id @default(uuid())
  profileId String
  otpCode   String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  profile Profile @relation("emailVerifications", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("email_verifications")
}

// Campaigns
model Campaign {
  id                 String   @id @default(uuid())
  ngoId              String
  title              String
  slug               String?   @unique
  description        String
  category           String?
  targetAmount       Decimal   @db.Decimal(14, 2)
  raisedAmount       Decimal   @default(0) @db.Decimal(14, 2)
  currencyCode       String    @default("INR")
  status             CampaignStatus @default(DRAFT)
  approvedBy         String?   // references profiles.id
  approvedAt         DateTime?
  coverImageUrl      String?
  startDate          DateTime?
  endDate            DateTime?
  sdgTags            String[]
  solanaProgramId    String?
  solanaVaultAddress String?
  ipfsCid            String?
  beneficiaryIdHash        String? @unique  // Campaign-bound HMAC-SHA256 verifier; raw ID never stored
  beneficiaryIdEncrypted   String?  // Authenticated encrypted Beneficiary ID for NGO retrieval
  beneficiaryName         String?  // Legacy plaintext; new writes use encrypted columns below
  beneficiaryDescription  String?  // Legacy plaintext; new writes use encrypted columns below
  beneficiaryNameEncrypted        String?
  beneficiaryDescriptionEncrypted String?
  createdAt                DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ngo       Profile @relation(fields: [ngoId], references: [id])
  donations Donation[]
  cohorts   BeneficiaryCohort[]
  disbursements Disbursement[] @relation("campaignDisbursements")
  documents Document[] @relation("campaignDocuments")

  @@index([ngoId])
  @@index([status])
  @@index([slug])
  @@map("campaigns")
}

// Donations
model Donation {
  id                 String   @id @default(uuid())
  publicId           String   @unique @default(cuid())
  donorId            String
  ngoId              String
  campaignId         String?
  amount             Decimal   @db.Decimal(14, 2)
  allocatedAmount    Decimal   @default(0) @db.Decimal(14, 2)
  currencyCode       String    @default("INR")
  paymentMethod      PaymentMethod
  status             DonationStatus @default(INITIATED)
  razorpayOrderId    String?   @unique
  razorpayPaymentId  String?   @unique
  donorMessage       String?
  taxReceiptUrl      String?
  taxReceiptEmailed  Boolean   @default(false)
  donorIdHash        String?
  solanaTxHash       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  attestations Attestation[]

  donor       Profile @relation("DonorDonations", fields: [donorId], references: [id])
  ngo         Profile @relation("NgoDonations", fields: [ngoId], references: [id])
  project     Campaign? @relation(fields: [campaignId], references: [id])
  govRequests GovernmentRequest[] @relation("GovRequestTargetDonation")
  impactTokens ImpactToken[] @relation("donationImpactTokens")
  donationAllocations DonationAllocation[]

  @@index([donorId])
  @@index([ngoId])
  @@index([campaignId])
  @@index([status])
  @@index([razorpayOrderId])
  @@map("donations")
}

// Donation Allocations
model DonationAllocation {
  id             String   @id @default(uuid())
  donationId     String
  disbursementId String
  amount         Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  donation     Donation     @relation(fields: [donationId], references: [id])
  disbursement Disbursement @relation(fields: [disbursementId], references: [id])
  bankTransfers BankTransfer[]

  @@index([donationId])
  @@index([disbursementId])
  @@map("donation_allocations")
}

// Beneficiary Cohorts
model BeneficiaryCohort {
  id                 String   @id @default(uuid())
  campaignId         String
  ngoId              String
  name               String
  beneficiaryCount   Int
  description        String?
  sha512DocHash      String?
  merkleRoot         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id])
  ngo    Profile   @relation(fields: [ngoId], references: [id])
  disbursements Disbursement[] @relation("disbursementsAsCohort")

  @@index([campaignId])
  @@index([ngoId])
  @@map("beneficiary_cohorts")
}

// Disbursements
model Disbursement {
  id                 String   @id @default(uuid())
  campaignId         String
  ngoId              String
  cohortId           String?
  disbursementType   DisbursementType @default(PROOF_OF_NEED)
  isFinalDisbursement Boolean @default(false)
  amountInr          Decimal   @db.Decimal(14, 2)
  amountSol          Decimal?  @db.Decimal(18, 8)
  fieldReportUrl     String?
  status             DisbursementStatus @default(PENDING)
  settlementDueAt    DateTime?
  approvedBy         String?   // references profiles.id
  approvedAt         DateTime?
  solanaTxHash       String?
  blockscoutUrl      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  proofSubmittedAt DateTime?   // new — set when NGO uploads proof post-creation
  rejectionReason  String?     // new — set by admin on reject

  campaign Campaign @relation("campaignDisbursements", fields: [campaignId], references: [id])
  ngo    Profile   @relation("disbursementsAsNgo", fields: [ngoId], references: [id])
  cohort BeneficiaryCohort? @relation("disbursementsAsCohort", fields: [cohortId], references: [id])
  documents Document[] @relation("disbursementDocuments")
  donationAllocations DonationAllocation[]
  attestations        Attestation[]

  @@index([campaignId])
  @@index([ngoId])
  @@index([status])
  @@index([status, settlementDueAt])
  @@map("disbursements")
}

// Documents
model Document {
  id            String   @id @default(uuid())
  ownerId       String
  campaignId    String?
  disbursementId String?
  bankTransferId String?
  documentType  DocumentType
  status        DocumentStatus @default(ACTIVE)
  storageBucket String
  storagePath   String
  originalFilename String?
  mimeType      String?
  sizeBytes     BigInt?
  sha512Hash    String
  ipfsCid       String?
  ipfsPinnedAt  DateTime?
  legalHold     Boolean  @default(false)
  ttlExpiry     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         Profile @relation(fields: [ownerId], references: [id])
  campaign      Campaign? @relation("campaignDocuments", fields: [campaignId], references: [id])
  disbursement  Disbursement? @relation("disbursementDocuments", fields: [disbursementId], references: [id])
  bankTransfer  BankTransfer? @relation(fields: [bankTransferId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([campaignId])
  @@index([disbursementId])
  @@index([bankTransferId])
  @@index([status])
  @@index([legalHold])
  @@map("documents")
}

enum BankTransferStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model BankTransfer {
  id                String            @id @default(uuid())
  ngoId             String
  allocationId      String
  amountInr         Decimal           @db.Decimal(14, 2)
  currencyCode      String
  transferDate      DateTime
  bankReference     String?
  submissionKey     String
  resubmissionOfId  String?
  status            BankTransferStatus @default(SUBMITTED)
  submittedAt       DateTime          @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectionReason   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ngo               Profile           @relation("bankTransfersAsNgo", fields: [ngoId], references: [id])
  reviewer          Profile?          @relation("bankTransfersReviewed", fields: [reviewedBy], references: [id])
  allocation        DonationAllocation @relation(fields: [allocationId], references: [id])
  previousSubmission BankTransfer?    @relation("BankTransferResubmissions", fields: [resubmissionOfId], references: [id], onDelete: Restrict)
  resubmissions      BankTransfer[]   @relation("BankTransferResubmissions")
  evidence          Document[]

  @@unique([ngoId, submissionKey])
  @@index([status, submittedAt])
  @@index([allocationId, status])
  @@index([ngoId, bankReference])
  @@index([resubmissionOfId])
  @@map("bank_transfers")
}

// Impact Tokens
model ImpactToken {
  id        String   @id @default(uuid())
  donationId String
  donorId    String
  minted     Boolean @default(false)
  mintedAt   DateTime?
  mintAddress String?
  metadataUri String?
  redeemed   Boolean @default(false)
  redeemedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  donation Donation @relation("donationImpactTokens", fields: [donationId], references: [id])
  donor    Profile @relation("impactTokensAsDonor", fields: [donorId], references: [id])

  @@index([donationId])
  @@index([donorId])
  @@map("impact_tokens")
}

// Government Requests
model GovernmentRequest {
  id                 String   @id @default(uuid())
  requestRef         String   @unique
  requestingBody     String
  legalBasis         String
  scope              Json     @default("{}")
  status             GovernmentRequestStatus @default(OPEN)
  createdBy          String?   // references profiles.id
  targetUserId       String?   // references profiles.id
  targetDonationId   String?   // references donations.id
  processedByAdminId String?   // references profiles.id
  filedAt            DateTime  @default(now())
  closedAt           DateTime?

  createdByUser Profile? @relation("govRequestsAsCreatedBy", fields: [createdBy], references: [id])
  targetUser   Profile? @relation("govRequestsAsTarget", fields: [targetUserId], references: [id])
  targetDonation Donation? @relation("GovRequestTargetDonation", fields: [targetDonationId], references: [id])
  processedBy    Profile?     @relation("govRequestsProcessed", fields: [processedByAdminId], references: [id])
  auditLogs      AuditLog[]   @relation("govRequestAuditLog")

  @@index([status])
  @@map("government_requests")
}

// Audit Logs
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorType AuditActorType
  actorId   String?   // references profiles.id
  entityType String
  entityId  String?
  action    String
  metadata  Json     @default("{}")
  ipAddress String?   // inet type, we store as string
  requestId String?
  govRequestId String? // references government_requests.id
  createdAt DateTime @default(now())

  actor Profile? @relation("auditLogsAsActor", fields: [actorId], references: [id])
  govRequest GovernmentRequest? @relation("govRequestAuditLog", fields: [govRequestId], references: [id])

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Blockchain Retry Queue
model BlockchainRetryQueue {
  id          String   @id @default(uuid())
  donationId  String   @unique
  error       String?
  operationType String? // RECORD_DONATION or UPDATE_STATUS
  retryCount  Int      @default(0)
  lastAttempt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  metadata    Json?    // extra info like targetStatus, etc.

  @@index([lastAttempt])
  @@index([operationType])
  @@map("BlockchainRetryQueue")
}

//Attestations
model Attestation {
  id              String            @id @default(uuid())
  donationId      String
  disbursementId  String?
  type            AttestationType
  allocatedAmount Decimal?          @db.Decimal(14, 2)
  status          AttestationStatus @default(PENDING)
  requestedBy     String            // donor's profile id
  ngoSignedBy     String?           // ngo's profile id, set on NGO sign-off
  ngoSignedAt     DateTime?
  approvedBy      String?           // admin's profile id
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  donation Donation @relation(fields: [donationId], references: [id])
  disbursement Disbursement? @relation(fields: [disbursementId], references: [id])

  @@unique([donationId, disbursementId, type])   // one RECEIPT + one DELIVERY attestation per donation per disbursement
  @@index([donationId])
  @@index([disbursementId])
  @@index([status])
  @@map("attestations")
}

model EmailOutbox {
  id                String            @id @default(uuid())
  eventKey          String            @unique
  milestone         EmailMilestone
  donationId        String
  disbursementId    String?
  payload           Json
  status            EmailOutboxStatus @default(PENDING)
  attemptCount      Int               @default(0)
  availableAt       DateTime          @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([donationId])
  @@map("email_outbox")
}

// Provenance Outbox
// ProvenanceEvent captures immutable financial lifecycle events for tamper-evident
// anchoring to Solana via traceit_anchor. Sequence (id) is gap-tolerant; the batch
// builder verifies contiguity before submission. occurredAt is supplied by the
// application (not @default(now())) so it can be included in the canonical payload
// before the INSERT, allowing payloadHash to be computed atomically in the same
// business transaction without any post-insert mutation.
model ProvenanceEvent {
  id               BigInt              @id @default(autoincrement())
  eventType        ProvenanceEventType
  entityType       String
  entityId         String
  amountInr        String
  ngoId            String?
  campaignId       String?
  occurredAt       DateTime
  canonicalPayload String
  payloadHash      String
  previous_hash    String?  // For legacy rows: stores payloadHash of previous event (incorrect). For new chain: stores chainHash of previous event or NULL.
  chainHash        String?    // SHA-512 chain hash: commits to event data + previous chain link. NULL for legacy rows.
  transitionKey    String

  anchorStatus     AnchorStatus        @default(PENDING)
  anchorBatchId    String?
  attemptCount     Int                 @default(0)
  lastError        String?
  processedAt      DateTime?

  anchorBatch      AnchorBatch?        @relation(fields: [anchorBatchId], references: [id])

  @@unique([entityId, eventType, transitionKey])
  @@index([anchorStatus])
  @@index([anchorBatchId])
  @@index([occurredAt])
  @@map("provenance_events")
}

// AnchorBatch records a submitted batch of provenance events.
// batchKey: first 32 bytes of SHA-512("TRACEIT_ANCHOR_V1" || u16BE(schemaVersion)
//           || u64BE(startSequence) || u64BE(endSequence) || u32BE(eventCount) || auditRoot)
// auditRoot: SHA-512("TRACEIT_AUDIT_ROOT_V1" || u16BE(schemaVersion)
//            || u64BE(startSequence) || u64BE(endSequence) || u32BE(eventCount)
//            || eventHash[0] || ... || eventHash[n-1])
model AnchorBatch {
  id                 String   @id @default(uuid())
  batchKey           String   @unique
  auditRoot          String
  startSequence      BigInt
  endSequence        BigInt
  eventCount         Int
  solanaTxSignature  String?
  anchorPda          String?
  anchoredAt         DateTime?
  status             String   @default("PENDING")
  attemptCount       Int      @default(0)
  reconciliationCount Int     @default(0)
  nextAttemptAt      DateTime @default(now())
  claimToken         String?
  claimExpiresAt     DateTime?
  lastError          String?
  createdAt          DateTime @default(now())

  provenanceEvents  ProvenanceEvent[]

  @@index([status])
  @@index([status, nextAttemptAt, createdAt], map: "anchor_batches_claim_idx")
  @@map("anchor_batches")
}
