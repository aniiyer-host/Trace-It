# TraceIt Backend Environment Variables
# Copy this file to .env and fill in the values

# Database Connections (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# CORS URLS
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_ACCESS_SECRET="your-access-token-secret-here-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-token-secret-here-min-32-chars"

# API Keys
GMAIL_USER="your-gmail-address@example.com"
GMAIL_APP_PASSWORD="your-16-character-gmail-app-password"
EMAIL_FROM="Trace It <your-gmail-address@example.com>"
# Optional personal inboxes for the seeded test NGO and primary donor. Leave
# unset to use the fake development defaults; never put these in a committed env.
# TRACEIT_TEST_NGO_EMAIL=""
# TRACEIT_TEST_DONOR_EMAIL=""
# Workers are disabled unless explicitly opted in. The email worker also requires
# a small positive per-run cap (1-10) so it cannot drain an unbounded backlog.
# TRACEIT_EMAIL_WORKER_ENABLED=false
# TRACEIT_EMAIL_MAX_JOBS_PER_RUN=2
# TRACEIT_ANCHOR_WORKER_ENABLED=false
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Legacy blockchain client integration (use Devnet for development)
BLOCKCHAIN_HMAC_SECRET="your-blockchain-hmac-secret"
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_WALLET_KEYPAIR_PATH="/path/to/solana/keypair.json"

# Durable Devnet Anchor worker. Keep all four values commented until a safe
# isolated database has the reviewed migration and the worker is explicitly
# cleared to start. Never point DATABASE_URL at the populated TraceIt database.
# TRACEIT_ANCHOR_RPC_URL="https://api.devnet.solana.com"
# TRACEIT_ANCHOR_WALLET_KEYPAIR_PATH="/home/aarus/.config/solana/traceit-v1-authority.json"
# TRACEIT_ANCHOR_PROGRAM_ID="3CLytt82BKNwqMQA7M9fqJrMAhgD5t9dpuDC4TwutVFa"
# TRACEIT_ANCHOR_CLUSTER="devnet"

# Storage (Backblaze B2)
B2_ACCOUNT_ID="your-backblaze-account-id"
B2_APPLICATION_KEY="your-backblaze-application-key"
B2_BUCKET_NAME="your-traceit-bucket-name"

# Secrets Management (HashiCorp Vault)
VAULT_ADDR="https://your-vault-address:8200"
VAULT_TOKEN="your-vault-token"
VAULT_NAMESPACE="traceit"

# Redis (for caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# Elasticsearch (for logging and SIEM)
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="your-elasticsearch-password"

# Application Settings
NODE_ENV="development"
PORT="3001"
HOST="0.0.0.0"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# File Upload Limits
MAX_FILE_SIZE="10485760" # 10MB

AES_BENEFICIARY_KEY="replace-with-a-separate-64-character-hex-key"
BENEFICIARY_HMAC_SECRET="replace-with-a-long-random-server-side-secret"
AES_DOCUMENT_KEY="replace-with-a-separate-64-character-hex-key"
