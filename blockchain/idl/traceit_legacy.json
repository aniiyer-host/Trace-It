  "accounts": [
    {
      "name": "AttestationAccount",
      "docs": [
        "Attestation account stored on-chain",
        "PDA seeds: [b\"attestation\", donation_id_without_hyphens, ngo_id_without_hyphens, attestation_type_bytes]"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "donationId",
            "docs": [
              "The off-chain donation UUID (same as in DonationRecord)"
            ],
            "type": "string"
          },
          {
            "name": "ngoId",
            "docs": [
              "NGO profile ID"
            ],
            "type": "string"
          },
          {
            "name": "attestationType",
            "docs": [
              "Type of attestation: 0=Receipt, 1=Delivery"
            ],
            "type": "u8"
          },
          {
            "name": "beneficiaryIdHash",
            "docs": [
              "Optional SHA-512 beneficiary ID hash (for delivery attestations)"
            ],
            "type": "string"
          },
          {
            "name": "attestationMessage",
            "docs": [
              "The signed attestation message (e.g., \"I, NGO-name, confirm receipt...\")"
            ],
            "type": "string"
          },
          {
            "name": "attestationMessageHash",
            "docs": [
              "Hash of the attestation message for integrity verification"
            ],
            "type": "string"
          },
          {
            "name": "ngoPublicKey",
            "docs": [
              "NGO's public key (base58 string) that signed the attestation"
            ],
            "type": "string"
          },
          {
            "name": "signedAt",
            "docs": [
              "Timestamp when attestation was signed"
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "Bump seed for PDA derivation"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "CohortRecord",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "cohortId",
            "type": "string"
          },
          {
            "name": "ngoId",
            "type": "string"
          },
          {
            "name": "sha512DocHash",
            "docs": [
              "SHA-512 hash of the cohort proof document bundle"
            ],
            "type": "string"
          },
          {
            "name": "beneficiaryCount",
            "docs": [
              "Beneficiary count"
            ],
            "type": "u32"
          },
          {
            "name": "createdAt",
            "docs": [
              "Unix timestamp"
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "Bump seed for PDA"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "DisbursementRecord",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "disbursementId",
            "type": "string"
          },
          {
            "name": "ngoId",
            "type": "string"
          },
          {
            "name": "cohortId",
            "type": "string"
          },
          {
            "name": "amountPaisa",
            "docs": [
              "Amount in paisa"
            ],
            "type": "u64"
          },
          {
            "name": "currency",
            "docs": [
              "Currency code (always \"INR\")"
            ],
            "type": "string"
          },
          {
            "name": "timestamp",
            "docs": [
              "Unix timestamp"
            ],
            "type": "i64"
          },
          {
            "name": "transactionHash",
            "docs": [
              "Transaction hash on Solana"
            ],
            "type": "string"
          },
          {
            "name": "status",
            "docs": [
              "0=Pending, 1=Approved, 2=Sent, 3=Settled, 4=Failed"
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "docs": [
              "Bump seed for PDA"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "DonationRecord",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "donationId",
            "docs": [
              "The off-chain donation UUID (stored as 36 bytes)"
            ],
            "type": "string"
          },
          {
            "name": "donorIdHash",
            "docs": [
              "SHA-512 hash of (userId + secret) — never store raw userId"
            ],
            "type": "string"
          },
          {
            "name": "ngoId",
            "docs": [
              "NGO profile ID"
            ],
            "type": "string"
          },
          {
            "name": "campaignId",
            "docs": [
              "Campaign/project ID"
            ],
            "type": "string"
          },
          {
            "name": "amountPaisa",
            "docs": [
              "Donation amount in paisa (INR * 100)"
            ],
            "type": "u64"
          },
          {
            "name": "currency",
            "docs": [
              "Currency code (always \"INR\")"
            ],
            "type": "string"
          },
          {
            "name": "timestamp",
            "docs": [
              "Unix timestamp of the donation"
            ],
            "type": "i64"
          },
          {
            "name": "status",
            "docs": [
              "Current status: 0=Initiated, 1=Success, 2=Allocated, 3=Disbursed, 4=Delivered"
            ],
            "type": "u8"
          },
          {
            "name": "recordHash",
            "docs": [
              "SHA-512 hash of the full donation record for tamper detection"
            ],
            "type": "string"
          },
          {
            "name": "bump",
            "docs": [
              "Bump seed for PDA derivation"
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "NgoRecord",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "ngoId",
            "type": "string"
          },
          {
            "name": "status",
            "docs": [
              "0=Pending, 1=Active, 2=Rejected, 3=Suspended"
            ],
            "type": "u8"
          },
          {
            "name": "metadataHash",
            "docs": [
              "SHA-512 hash of NGO verification documents"
            ],
            "type": "string"
          },
          {
            "name": "registeredAt",
            "docs": [
              "Unix timestamp of registration"
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "Bump seed for PDA"
            ],
            "type": "u8"
          }
        ]
      }
    }
  ],
  "errors": [
    {
      "code": 6000,
      "name": "InvalidInput",
      "msg": "Invalid input: field exceeds maximum length"
    },
    {
      "code": 6001,
      "name": "InvalidAmount",
      "msg": "Invalid amount: must be greater than zero"
    },
    {
      "code": 6002,
      "name": "InvalidStatusTransition",
      "msg": "Invalid status transition"
    },
    {
      "code": 6003,
      "name": "NgoNotActive",
      "msg": "NGO is not active"
    },
    {
      "code": 6004,
      "name": "Unauthorized",
      "msg": "Unauthorized: only the program authority can perform this action"
    }
  ]
